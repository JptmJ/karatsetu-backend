# ---- database ----------------------------------------------------------
# Paste your connection string here. This is the only value with no default.
DATABASE_URL=postgres://user:password@localhost:5432/swarnay

# false | true | no-verify   (managed providers usually need no-verify)
DATABASE_SSL=false
DATABASE_POOL_MAX=10
# Seconds between keep-alive pings to the database. 0 turns it off.
DB_HEARTBEAT_SECONDS=60

# ---- schema sync -------------------------------------------------------
# off    do nothing
# verify report drift and refuse to boot   <- use this in production
# safe   apply additive changes, block destructive ones   <- default for dev
# force  apply everything, including drops  <- never point at production
SCHEMA_SYNC_MODE=safe

# ---- app ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-something-long-and-random
JWT_ACCESS_TTL=15m

# Comma-separated origins of web apps on another domain that may call the API.
CORS_ORIGINS=http://localhost:5173,http://localhost:4100
